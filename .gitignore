# Estado de base de datos local, nunca código fuente. La barra inicial
# evita ignorar public/data/, que contiene los JSON versionados del sitio.
/data/

# Secretos locales: nunca se versiona ningún archivo .env.
.env
.env.*

# Dependencias de desarrollo (eslint y globals).
node_modules/
.netlify/

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
