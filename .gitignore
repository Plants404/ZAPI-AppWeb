# Base de datos: estado, no codigo. Vuelve junto con el backend nuevo;
# va a contener pedidos, telefonos de clientes y stock.
# La barra inicial importa: sin ella, git ignoraria tambien
# public/data/, que es el catalogo en JSON que si se versiona.
/data/

# Secretos. El backend lee la configuracion de .env (MONGODB_URI,
# secretos, DEEPSEEK_API_KEY, etc.). Nunca se versiona ningun .env:
# se versiona .env.example con los nombres de las variables y valores
# falsos.
.env
.env.*
!.env.example

# Dependencias. eslint y globals son de desarrollo; express, mongoose
# y helmet son del backend.
node_modules/

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
