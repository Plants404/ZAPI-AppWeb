# Base de datos: estado, no codigo. Hoy no hay backend, pero la regla
# queda para cuando se vuelva a armar (pedidos, telefonos, stock).
# La barra inicial importa: sin ella, git ignoraria tambien
# public/data/, que es el catalogo en JSON que si se versiona.
/data/

# Secretos locales: nunca se versiona ningun archivo .env,
# salvo .env.example que documenta las variables sin valores reales.
.env
.env.*
!.env.example

# Dependencias de desarrollo (eslint y globals).
node_modules/

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
