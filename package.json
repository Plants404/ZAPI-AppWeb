{
  "name": "zapi-appweb",
  "private": true,
  "description": "Sitio de ZAPI: HTML en la raiz, recursos en public/, servidor y base en server/ y herramientas en tools/.",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "api": "node tools/probar-api.js",
    "verificar": "node tools/verificar.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run verificar",
    "contraste": "node tools/contraste.js",
    "generar": "node tools/generar-productos.js",
    "sitemap": "node tools/generar-sitemap.js",
    "css": "node tools/extraer-modal-css.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
