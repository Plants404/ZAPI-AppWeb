{
  "name": "zapi-appweb",
  "private": true,
  "description": "Frontend estático ZAPI y API REST de autenticación con Express y MongoDB.",
  "scripts": {
    "start": "node tools/servir.js",
    "start:api": "node backend/server.js",
    "admin:crear": "node scripts/crear-admin.js",
    "test:api": "node --test tests/backend/auth.test.js",
    "verificar": "node tools/verificar.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run verificar",
    "contraste": "node tools/contraste.js",
    "generar": "node tools/generar-productos.js",
    "generar:testimonios": "node tools/generar-testimonios.js",
    "sitemap": "node tools/generar-sitemap.js",
    "css": "node tools/extraer-modal-css.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2"
  }
}
