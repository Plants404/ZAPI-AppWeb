{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend",
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/api/index?__zapiPath=/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/depurar",
      "schedule": "0 3 * * *"
    }
  ]
}
