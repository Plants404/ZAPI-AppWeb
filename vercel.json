{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zapi-backend.onrender.com/api/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/depurar",
      "schedule": "0 3 * * *"
    }
  ]
}
