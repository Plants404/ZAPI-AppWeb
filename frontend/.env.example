# ==============================================================================
# CONFIGURACIÓN DEL FRONTEND ZAPI
# ==============================================================================
# El frontend de ZAPI es una aplicación estática (HTML, CSS y JavaScript clásico).
# No contiene secretos ni contraseñas.
#
# Variables para el servidor local de desarrollo (tools/servir.js):
PORT=5500

# URL de la API del backend:
# Por defecto en local apunta a http://localhost:5501 (configurada en public/js/config.js).
# Puede ser sobreescrita en el navegador con:
# 1. La variable global window.__ZAPI_API__ (ej. desde un script previo).
# 2. La etiqueta <meta name="zapi-api" content="http://localhost:5501">.
# 3. En producción o Netlify Dev, utiliza rutas relativas /api/* hacia las Functions.
VITE_API_URL=http://localhost:5501
