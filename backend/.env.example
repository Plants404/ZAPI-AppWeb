# ==============================================================================
# CONFIGURACIÓN DEL BACKEND ZAPI
# ==============================================================================
# Copiar este archivo a .env en el directorio backend/ o en la raíz del proyecto.
# NUNCA incluyas credenciales reales en el repositorio.
#
# PowerShell: Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env
# ==============================================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor HTTP
PORT=5501

# Conexión a MongoDB (debe ser un replica set si se utilizan transacciones de pedidos)
MONGODB_URI=mongodb://127.0.0.1:27017/zapi?replicaSet=rs0

# Clave secreta para firmar los tokens JWT de sesión (mínimo 32 caracteres)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar-con-secreto-aleatorio-de-al-menos-32-caracteres

# Duración de la sesión JWT
JWT_EXPIRES_IN=12h

# Orígenes autorizados para CORS (separados por coma)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Configuración de cookies de sesión
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Proxy reverso (1 si está detrás de Nginx, Cloudflare o Netlify Functions)
TRUST_PROXY=0

# Control de cuentas: false desactiva inicio de sesión obligatorio para pedidos
REQUIERE_CUENTA=true

# Registro público de cuentas: false permite únicamente creación de administradores
REGISTRO_PUBLICO=false

# Credenciales para el script inicial de administrador (npm run admin:crear)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@zapi.uy
ADMIN_PASSWORD=ContrasenaSeguraDeEjemplo123!
