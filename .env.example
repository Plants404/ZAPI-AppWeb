# Marcadores de ejemplo: completalos solo en tu .env local, nunca acá ni en Vercel.
MONGODB_URI=mongodb+srv://USUARIO_EJEMPLO:REEMPLAZAR_CON_PASSWORD@cluster0.ejemplo.mongodb.net/

# Nombre de la base de datos
MONGODB_DB=zapi-api2

# Puerto en el que escucha la API
PORT=5501

# Host en el que escucha la API
HOST=127.0.0.1

# Origen público del proyecto (en local se permiten los puertos de desarrollo)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Saltos de proxy delante de la app (Vercel usa proxy; 0 en local sin proxy)
TRUST_PROXY=1

# Dirección pública del backend Render para generar desde el snapshot publicado
ZAPI_API_URL=https://zapi-backend.onrender.com

# URL del webhook de redeploy en Vercel (opcional)
DEPLOY_HOOK_URL=

# Secreto para proteger el endpoint /api/depurar (cron de Vercel)
CRON_SECRET=<SECRETO_ALEATORIO>
