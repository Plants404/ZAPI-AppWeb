# Copiar a .env y completar. .env no se versiona.
# En PowerShell: copy .env.example .env
# En Linux/Mac:   cp .env.example .env
#
# npm start lo carga solo (lleva --env-file-if-exists=.env). Todas las
# variables de abajo son opcionales: sin este archivo el servidor
# arranca igual con estos valores por defecto.
#
# Si arrancas el servidor sin npm, el archivo hay que pasarselo a mano:
#   node --env-file=.env server.js

# Secreto para firmar la cookie de sesion del carrito.
# Sin esto el servidor genera uno al azar cada vez que arranca, y al
# reiniciar se pierden todos los carritos abiertos.
# Para generarlo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZAPI_SESSION_SECRET=

# Token que hay que mandar en x-zapi-token para cambiar el stock.
# Si queda vacio, la carga de stock queda deshabilitada.
# Mismo comando para generarlo que arriba.
ZAPI_ADMIN_TOKEN=

# Puerto del servidor. 5501 es el que ya usaba el Live Server.
PORT=5501

# production activa: cookies Secure, cache de estaticos y el mensaje
# de "modo desarrollo". En desarrollo se puede dejar vacío.
NODE_ENV=

# Ruta del archivo SQLite. Si se deja vacío se usa data/zapi.db.
# Cambiarlo crea otra base con otro catálogo: es para pruebas o para
# tener varias bases en paralelo, no para mover la de producción.
ZAPI_DB=

# MongoDB. Lo usa modelo/mongodb.js, que todavia no reemplaza a
# SQLite: por ahora es el modelo y la conexion de referencia.
# Cadena de conexion completa, igual que la acepta mongosh.
ZAPI_MONGO_URL=
# Nombre de la base dentro de esa conexion. Vacío = zapi.
ZAPI_MONGO_DB=
# Espera maxima de una operacion, en ms. Vacío = 30000.
ZAPI_MONGO_TIMEOUT=
# Espera maxima de una escritura, en ms. Vacío = 5000.
ZAPI_MONGO_TIMEOUT_ESCRITURA=
# Peticiones simultaneas por operacion. Vacío = 10 y 1.
ZAPI_MONGO_MAX_POOL=
ZAPI_MONGO_MIN_POOL=

# Rate limiting por IP y ventana, en peticiones. Vacío = valor por
# defecto. Los suben las pruebas de la API (npm run api) para no
# comerse un 429 a mitad de camino.
# Lectura del catálogo: 120 por minuto.
ZAPI_LIMITE_LECTURA=
# Escritura (carrito, pedidos, contacto, stock): 20 por 10 minutos.
ZAPI_LIMITE_ESCRITURA=
