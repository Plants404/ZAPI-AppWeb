# Configuracion del backend ZAPI.
#
# Copiar a .env y completar. .env no se versiona (ver .gitignore).
#   PowerShell: copy .env.example .env
#   Linux/Mac:  cp .env.example .env
#
# Los scripts del backend cargan .env con --env-file-if-exists=.env,
# asi que sin este archivo el servidor arranca igual con los valores
# por defecto de abajo.

# Entorno: development | test | production.
NODE_ENV=development

# Puerto HTTP del servidor.
PORT=5501

# Cadena de conexion de MongoDB. Con un Mongo local alcanza el valor
# por defecto; con Atlas va la cadena completa, con usuario y clave.
MONGODB_URI=mongodb://127.0.0.1:27017/zapi

# Origenes autorizados para CORS, separados por coma. El sitio se sirve
# desde el mismo servidor, asi que en local alcanza con el default.
CLIENT_URL=http://localhost:5501

# Rate limiting por IP y ventana, en peticiones. Los valores por
# defecto son los de produccion; las pruebas los suben para no comerse
# un 429 a mitad de camino.
# Lectura (catalogo, testimonios, salud): 120 por minuto.
ZAPI_LIMITE_LECTURA=120
# Escritura (contacto, carrito, pedidos): 20 por 10 minutos.
ZAPI_LIMITE_ESCRITURA=20
# Registro y login (probar contraseñas): 10 por 10 minutos.
ZAPI_LIMITE_AUTH=10

# Secreto para firmar la cookie de sesion del carrito. Generarlo con:
#   PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatorio en produccion.
ZAPI_SESSION_SECRET=

# Token del panel administrativo (cargar stock con PUT /api/stock/:id).
# Va en la cabecera x-zapi-token.
ZAPI_ADMIN_TOKEN=

# ------------------------------------------------------------------
# Asistente (por reglas)
# ------------------------------------------------------------------
# El asistente no usa un modelo generativo: responde por reglas con
# los datos del negocio (config/business.js) y el catalogo, y guarda
# lo que contesta en la coleccion faqs para reutilizarlo.
#
# Limite del chat: mensajes por minuto y por IP. Va aparte del de
# escritura porque mueve mas.
ZAPI_LIMITE_CHAT=15

# Umbral (0-1) de parecido para reutilizar una FAQ guardada.
ZAPI_FAQ_UMBRAL=0.55


