# ==============================================================================
# CONFIGURACIÓN DE ZAPI
# ==============================================================================
# Copiar este archivo a .env en la raíz del proyecto.
# NUNCA incluyas credenciales reales en el repositorio.
#
# PowerShell: Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env
# ==============================================================================

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto de la API
PORT=5501

# Conexión a MongoDB. Para desarrollo local con transacciones se necesita un
# replica set (por ejemplo: mongodb://127.0.0.1:27017/zapi?replicaSet=rs0).
# En MongoDB Atlas el replica set ya está incluido en la cadena de conexión.
MONGODB_URI=mongodb://127.0.0.1:27017/zapi?replicaSet=rs0

# Clave secreta para firmar las sesiones (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar-con-un-secreto-aleatorio-de-al-menos-32-caracteres

# Duración de la sesión
JWT_EXPIRES_IN=12h

# Orígenes autorizados para CORS (separados por coma)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Cookies de sesión
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Proxy reverso (1 si está detrás de Nginx, Cloudflare o Netlify Functions)
TRUST_PROXY=0

# ------------------------------------------------------------------------------
# El super admin NO se crea desde la web ni al conectar la base.
# Se crea una única vez con:
#
#   $env:ADMIN_NOMBRE="Administrador"
#   $env:ADMIN_EMAIL="admin@zapi.uy"
#   $env:ADMIN_CLAVE="una-clave-de-12-caracteres-o-mas"
#   npm run admin:crear
#
# El script exige una contraseña de al menos 12 caracteres y no acepta
# credenciales guardadas en el repositorio.
# ------------------------------------------------------------------------------
